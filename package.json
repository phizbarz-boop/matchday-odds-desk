{
  "name": "matchday-odds-desk",
  "version": "1.0.0",
  "private": true,
  "description": "Daily football match probability dashboard using a Poisson goal-expectancy model.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "browser:download": "playwright install chromium",
    "browser:install": "playwright install --with-deps chromium",
    "refresh": "node jobs/refresh.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "playwright": "1.62.1",
    "redis": "^4.7.0",
    "undici": "^6.19.0"
  },
  "engines": {
    "node": ">=20"
  }
}
